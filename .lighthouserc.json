{
  "ci": {
    "collect": {
      "startServerCommand": "node node_modules/serve/build/main.js dist --listen 4173",
      "startServerReadyPattern": "Accepting connections",
      "startServerReadyTimeout": 100000,
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/on-gorusme.html",
        "http://localhost:4173/iso-50001-enerji-yonetimi.html",
        "http://localhost:4173/sektorel-cozumler.html",
        "http://localhost:4173/sektor-uretim-metal.html",
        "http://localhost:4173/kaynaklar.html",
        "http://localhost:4173/referanslar.html",
        "http://localhost:4173/gizlilik-politikasi.html"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "speed-index": ["error", { "maxNumericValue": 3400 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 350000 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
