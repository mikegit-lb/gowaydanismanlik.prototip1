{
  "name": "gowaydanismanlik-site",
  "version": "1.0.0",
  "private": true,
  "description": "Goway Danışmanlık static website build pipeline",
  "scripts": {
    "build": "npm run generate && npm run seo && npm run analytics && node scripts/build.mjs",
    "generate": "node scripts/sitegen.mjs",
    "generate:check": "node scripts/sitegen.mjs",
    "seo": "node scripts/seo.mjs",
    "analytics": "node scripts/analytics.mjs",
    "lighthouse": "lhci autorun",
    "ci": "npm run build && npm run lighthouse",
    "build:watch": "node scripts/build.mjs --watch",
    "dev": "concurrently --kill-others-on-fail --names build,serve \"npm run build:watch\" \"browser-sync start --server dist --files dist/**/* --no-open\"",
    "start": "browser-sync start --server dist --files dist/**/*",
    "clean": "node scripts/build.mjs --clean",
    "minify": "npm-run-all build",
    "build:css": "node scripts/build.mjs",
    "build:js": "node scripts/build.mjs",
    "build:html": "node scripts/build.mjs",
    "build:images": "node scripts/build.mjs"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^9.1.2",
    "cssnano": "^7.0.6",
    "html-minifier-terser": "^7.2.0",
    "@lhci/cli": "^0.15.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.3",
    "sharp": "^0.35.3",
    "serve": "^14.2.4",
    "terser": "^5.39.0"
  }
}
